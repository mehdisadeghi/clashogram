#: clashogram/commands.py:80 clashogram/commands.py:384
msgid "I follow Clash of Clans wars and post them here."
msgstr "من جنگ‌های کلش رو دنبال می‌کنم و اینجا می‌ذارم."

#: clashogram/commands.py:84
msgid ""
"No names on channel posts, so I cannot tell who you are here. Send me "
"this directly instead:"
msgstr ""
"رو پست‌های کانال اسمی نیست، پس نمی‌فهمم تو کی هستی. این رو مستقیم برام "
"بفرست:"

#: clashogram/commands.py:85 clashogram/commands.py:219
#, python-brace-format
msgid "/add CLAN_TAG {chat}"
msgstr "/add CLAN_TAG {chat}"

#: clashogram/commands.py:87
msgid "Whoever runs this chat can start me off:"
msgstr "هر کی این چت رو می‌گردونه می‌تونه راهم بندازه:"

#: clashogram/commands.py:88
msgid "/follow CLAN_TAG"
msgstr "/follow CLAN_TAG"

#: clashogram/commands.py:89
msgid "/help for the rest."
msgstr "بقیه‌ش با /help."

#: clashogram/commands.py:141
msgid "Unknown command. Try /help."
msgstr "این دستور رو نمی‌شناسم. /help رو بزن."

#: clashogram/commands.py:144 clashogram/commands.py:400
msgid "No clan followed here yet."
msgstr "هنوز هیچ قبیله‌ای اینجا دنبال نمی‌شه."

#: clashogram/commands.py:168
msgid "I post attacks, prep, standings and result."
msgstr "من حمله، آماده‌سازی، جدول و نتیجه می‌ذارم."

#: clashogram/commands.py:171 clashogram/commands.py:203
msgid "Only somebody who runs this chat can change that."
msgstr "فقط کسی که این چت رو می‌گردونه می‌تونه این رو عوض کنه."

#: clashogram/commands.py:175
msgid "Tap to turn a kind on or off."
msgstr "بزن تا هر کدوم رو روشن یا خاموش کنی."

#: clashogram/commands.py:197
msgid "Which language?"
msgstr "کدوم زبان؟"

#: clashogram/commands.py:201
msgid "I do not speak that."
msgstr "این زبون رو بلد نیستم."

#: clashogram/commands.py:207
#, python-brace-format
msgid "Talking {lang} here now."
msgstr "از این به بعد اینجا {lang} حرف می‌زنم."

#: clashogram/commands.py:214
#, python-brace-format
msgid "This chat is {chat}."
msgstr "شناسه این چت {chat} است."

#: clashogram/commands.py:216
msgid "That is your own user id too."
msgstr "همین شناسه خودتم هست."

#: clashogram/commands.py:218
msgid "To follow a clan here:"
msgstr "برای اضافه کردن قبیله اینجا:"

#: clashogram/commands.py:221
msgid "To ask for a clan here:"
msgstr "برای درخواست قبیله اینجا:"

#: clashogram/commands.py:222
msgid "/request CLAN_TAG"
msgstr "/request CLAN_TAG"

#: clashogram/commands.py:239
msgid "How the war stands"
msgstr "وضعیت جنگ"

#: clashogram/commands.py:240
msgid "How long the war has to run"
msgstr "چقدر از جنگ مونده"

#: clashogram/commands.py:241
msgid "Who still has attacks"
msgstr "کی حمله نزده"

#: clashogram/commands.py:242
msgid "Who is facing whom"
msgstr "کی مقابل کیه"

#: clashogram/commands.py:243
msgid "The league table"
msgstr "جدول لیگ"

#: clashogram/commands.py:244
msgid "League attack stats"
msgstr "آمار حمله‌های لیگ"

#: clashogram/commands.py:245
msgid "The clan itself"
msgstr "خود قبیله"

#: clashogram/commands.py:246
msgid "Who runs the clan"
msgstr "کیا قبیله رو می‌گردونن"

#: clashogram/commands.py:247
msgid "Who has given the most"
msgstr "کی بیشتر داده"

#: clashogram/commands.py:248
msgid "Pick the language here"
msgstr "انتخاب زبان اینجا"

#: clashogram/commands.py:249
msgid "This chat's id"
msgstr "شناسه این چت"

#: clashogram/commands.py:250
msgid "What I can do"
msgstr "کارهایی که بلدم"

#: clashogram/commands.py:254
msgid "What is followed where"
msgstr "چی کجا دنبال می‌شه"

#: clashogram/commands.py:255
msgid "Follow a clan here"
msgstr "دنبال کردن یه قبیله اینجا"

#: clashogram/commands.py:256
msgid "Stop following a clan here"
msgstr "ول کردن یه قبیله اینجا"

#: clashogram/commands.py:257
msgid "Follow a clan in another chat"
msgstr "دنبال کردن یه قبیله تو یه چت دیگه"

#: clashogram/commands.py:258
msgid "Stop following a clan"
msgstr "ول کردن قبیله"

#: clashogram/commands.py:259
msgid "Who has asked"
msgstr "کی درخواست داده"

#: clashogram/commands.py:260
msgid "Choose what I post"
msgstr "انتخاب چیزی که می‌ذارم"

#: clashogram/commands.py:261
msgid "Who may operate"
msgstr "اپراتورها کی‌ان"

#: clashogram/commands.py:262
msgid "Let somebody help"
msgstr "اپراتور کردن یکی"

#: clashogram/commands.py:263
msgid "Stop letting them"
msgstr "گرفتن اپراتوری"

#: clashogram/commands.py:280
#, python-brace-format
msgid ""
"No names on channel posts, so I cannot tell it is you boss! Send it to me"
" directly and add this chat: {chat}"
msgstr ""
"رئیس، پست‌های کانال اسم ندارن، نمی‌فهمم تویی! مستقیم به خودم بگو و این چت"
" رو هم بنویس: {chat}"

#: clashogram/commands.py:282
msgid "Owner only boss! Ask them."
msgstr "رئیس، این فقط کار مالکه! ازش بخواه."

#: clashogram/commands.py:284
msgid "Operators only! Ask for your clan instead: /request CLAN_TAG"
msgstr "فقط اپراتورها! به جاش قبیله‌ت رو درخواست بده: /request CLAN_TAG"

#: clashogram/commands.py:285
msgid "Operators only! Ask one to add your clan here."
msgstr "فقط اپراتورها! از یکی‌شون بخواه قبیله‌ت رو اضافه کنه."

#: clashogram/commands.py:324
msgid "somebody"
msgstr "یکی"

#: clashogram/commands.py:333
#, python-brace-format
msgid "this chat ({chat})"
msgstr "همین چت ({chat})"

#: clashogram/commands.py:387
#, python-brace-format
msgid "Following {clans} here."
msgstr "اینجا {clans} دنبال می‌شه."

#: clashogram/commands.py:389
msgid "About the war:"
msgstr "درباره جنگ:"

#: clashogram/commands.py:390
msgid "  /war        how it stands"
msgstr "  /war        وضعیت جنگ"

#: clashogram/commands.py:391
msgid "  /missing    who still has attacks"
msgstr "  /missing    کی حمله نزده"

#: clashogram/commands.py:392
msgid "  /standings  the league table"
msgstr "  /standings  جدول لیگ"

#: clashogram/commands.py:393
msgid "  /stats      league attack stats"
msgstr "  /stats      آمار حمله‌های لیگ"

#: clashogram/commands.py:394
msgid "  /clan       the clan itself"
msgstr "  /clan       خود قبیله"

#: clashogram/commands.py:395
msgid "  /leaders    who runs it"
msgstr "  /leaders    کیا می‌گردوننش"

#: clashogram/commands.py:396
msgid "  /left       how long the war has to run"
msgstr "  /left       چقدر از جنگ مونده"

#: clashogram/commands.py:397
msgid "  /mirror     who is facing whom"
msgstr "  /mirror     کی مقابل کیه"

#: clashogram/commands.py:398
msgid "  /donors     who has given the most"
msgstr "  /donors     کی بیشتر داده"

#: clashogram/commands.py:405
msgid "To ask for one:"
msgstr "برای درخواست:"

#: clashogram/commands.py:406
msgid "  /request CLAN_TAG    ask for a clan here"
msgstr "  /request CLAN_TAG    درخواست قبیله برای اینجا"

#: clashogram/commands.py:408
msgid "Requests are closed. Ask an operator!"
msgstr "درخواست‌ها بسته‌ست. از یه اپراتور بخواه!"

#: clashogram/commands.py:411
#, python-brace-format
msgid ""
"No names on channel posts, so I cannot tell who you are here. Anything "
"that changes things, send to me directly and add this chat ({chat})."
msgstr ""
"پست‌های کانال اسم ندارن، پس نمی‌فهمم کی هستی. هر چیزی که تغییری می‌ده رو "
"مستقیم به خودم بگو و این چت ({chat}) رو هم بنویس."

#: clashogram/commands.py:412
msgid "You can add me to a group or a channel too."
msgstr "منو به گروه یا کانال هم می‌تونی اضافه کنی."

#: clashogram/commands.py:413
msgid "Anywhere:"
msgstr "همه‌جا:"

#: clashogram/commands.py:414
msgid "  /chatid     this chat's id, and yours if we talk directly"
msgstr "  /chatid     شناسه این چت، و شناسه خودت اگه مستقیم حرف بزنیم"

#: clashogram/commands.py:415
msgid "  /lang       pick the language here"
msgstr "  /lang       انتخاب زبان اینجا"

#: clashogram/commands.py:416
msgid "  /mute       choose what I post here"
msgstr "  /mute       انتخاب چیزی که اینجا می‌ذارم"

#: clashogram/commands.py:417
msgid "  /help       this message"
msgstr "  /help       همین پیام"

#: clashogram/commands.py:420
msgid "Owner:"
msgstr "مالک:"

#: clashogram/commands.py:421
msgid "  /operators              who may operate"
msgstr "  /operators              اپراتورها کی‌ان"

#: clashogram/commands.py:422
msgid "  /addoperator USER_ID    let somebody help"
msgstr "  /addoperator USER_ID    یکی رو اپراتور کن"

#: clashogram/commands.py:423
msgid "  /removeoperator USER_ID stop letting them"
msgstr "  /removeoperator USER_ID اپراتوریش رو بگیر"

#: clashogram/commands.py:424
msgid "  /requests open|close    take requests, or stop"
msgstr "  /requests open|close    درخواست‌ها رو باز یا بسته کن"

#: clashogram/commands.py:425
msgid "They send me /chatid directly to find their user id."
msgstr "شناسه‌شون رو با زدن /chatid به صورت مستقیم به من پیدا می‌کنن."

#: clashogram/commands.py:427
msgid "Operator:"
msgstr "اپراتور:"

#: clashogram/commands.py:428
msgid "  /clans                     what is followed where"
msgstr "  /clans                     چی کجا دنبال می‌شه"

#: clashogram/commands.py:429
msgid "  /follow CLAN_TAG           follow a clan here"
msgstr "  /follow CLAN_TAG           دنبال کردن قبیله اینجا"

#: clashogram/commands.py:430
msgid "  /unfollow CLAN_TAG         stop following here"
msgstr "  /unfollow CLAN_TAG         ول کردن قبیله اینجا"

#: clashogram/commands.py:431
msgid "  /add CLAN_TAG [CHAT]       follow one in CHAT"
msgstr "  /add CLAN_TAG [CHAT]       دنبال کردن قبیله تو CHAT"

#: clashogram/commands.py:432
msgid "  /remove CLAN_TAG [CHAT]    stop following"
msgstr "  /remove CLAN_TAG [CHAT]    ول کردن قبیله"

#: clashogram/commands.py:436
msgid "  /requests                  who has asked"
msgstr "  /requests                  کی درخواست داده"

#: clashogram/commands.py:437
msgid "  /approve ID, /deny ID      settle a request"
msgstr "  /approve ID, /deny ID      قبول یا رد درخواست"

#: clashogram/commands.py:440
msgid "Requests are closed, so clans are yours to add."
msgstr "درخواست‌ها بسته‌ست، پس اضافه کردن قبیله با خودته."

#: clashogram/commands.py:442
msgid ""
"I cannot tell who posts in a channel. Add me there, then send /add here "
"with the id I report."
msgstr ""
"تو کانال نمی‌فهمم کی پست می‌ذاره. اونجا اضافه‌م کن، بعد با شناسه‌ای که "
"می‌گم اینجا /add بزن."

#: clashogram/commands.py:452 clashogram/commands.py:458
#: clashogram/commands.py:477 clashogram/commands.py:496
msgid "Not in a war."
msgstr "الان جنگی نیست."

#: clashogram/commands.py:464 clashogram/commands.py:470
msgid "Not in a league war."
msgstr "الان جنگ لیگ نیست."

#: clashogram/commands.py:479
msgid "until battle day"
msgstr "تا روز جنگ"

#: clashogram/commands.py:481
msgid "until the war ends"
msgstr "تا آخر جنگ"

#: clashogram/commands.py:483
msgid "The war is over."
msgstr "جنگ تموم شده."

#: clashogram/commands.py:488
msgid "Any moment now."
msgstr "همین الاناست."

#: clashogram/commands.py:490
#, python-brace-format
msgid "{hours}h {minutes}m {what}"
msgstr "{hours} ساعت و {minutes} دقیقه {what}"

#: clashogram/commands.py:499
msgid "Everyone against their mirror:"
msgstr "هر کی مقابل قرینه‌ش:"

#: clashogram/commands.py:505
msgid "Nobody has given anything."
msgstr "هیچ‌کس چیزی نداده."

#: clashogram/commands.py:508
msgid "Given, received, name:"
msgstr "داده، گرفته، نام:"

#: clashogram/commands.py:513
#, python-brace-format
msgid "War win streak {streak} {flag}"
msgstr "برد پشت سر هم {streak} {flag}"

#: clashogram/commands.py:516 clashogram/commands.py:526
#, python-brace-format
msgid "Leader {name}"
msgstr "رئیس قبیله {name}"

#: clashogram/commands.py:524
msgid "Nobody is listed."
msgstr "هیچ‌کس ثبت نشده."

#: clashogram/commands.py:526
#, python-brace-format
msgid "Co-leader {name}"
msgstr "معاون {name}"

#: clashogram/commands.py:550
msgid "No clans followed."
msgstr "هیچ قبیله‌ای دنبال نمی‌شه."

#: clashogram/commands.py:566
#, python-brace-format
msgid "{clan} in {chat}"
msgstr "{clan} در {chat}"

#: clashogram/commands.py:568
msgid "Stop following"
msgstr "ولش کن"

#: clashogram/commands.py:574
msgid "Usage: /add CLAN_TAG [CHAT_ID]"
msgstr "طرز استفاده: /add CLAN_TAG [CHAT_ID]"

#: clashogram/commands.py:579 clashogram/commands.py:743
#, python-brace-format
msgid "No clan with tag {clan}!"
msgstr "قبیله‌ای با تگ {clan} نیست!"

#: clashogram/commands.py:585
#, python-brace-format
msgid "Following {name} ({clan}) in {chat}."
msgstr "{name} ({clan}) تو {chat} دنبال می‌شه."

#: clashogram/commands.py:618
msgid "Usage: /remove CLAN_TAG [CHAT_ID]"
msgstr "طرز استفاده: /remove CLAN_TAG [CHAT_ID]"

#: clashogram/commands.py:623
#, python-brace-format
msgid "{clan} was not followed in {chat}."
msgstr "{clan} تو {chat} دنبال نمی‌شد."

#: clashogram/commands.py:625
#, python-brace-format
msgid "Stopped following {clan} in {chat}."
msgstr "{clan} تو {chat} ول شد."

#: clashogram/commands.py:633
msgid "Requests are open."
msgstr "درخواست‌ها بازه."

#: clashogram/commands.py:634
msgid "Requests are closed."
msgstr "درخواست‌ها بسته‌ست."

#: clashogram/commands.py:636
msgid "Usage: /requests [open|close]"
msgstr "طرز استفاده: /requests [open|close]"

#: clashogram/commands.py:639
msgid "Nothing waiting."
msgstr "چیزی در انتظار نیست."

#: clashogram/commands.py:642 clashogram/commands.py:754
#, python-brace-format
msgid "{who} wants {name} ({clan}) in {chat}."
msgstr "{who} می‌خواد {name} ({clan}) تو {chat} باشه."

#: clashogram/commands.py:651
msgid "Approve"
msgstr "قبول"

#: clashogram/commands.py:652
msgid "Deny"
msgstr "رد"

#: clashogram/commands.py:665
msgid "Usage: /approve REQUEST_ID"
msgstr "طرز استفاده: /approve REQUEST_ID"

#: clashogram/commands.py:668
msgid "No request with that number."
msgstr "درخواستی با این شماره نیست."

#: clashogram/commands.py:673
#, python-brace-format
msgid "{clan} is in! Its wars land here from now on."
msgstr "{clan} اومد! از این به بعد جنگ‌هاش اینجا میاد."

#: clashogram/commands.py:675
#, python-brace-format
msgid "{clan} was turned down."
msgstr "{clan} رد شد."

#: clashogram/commands.py:677
#, python-brace-format
msgid "Approved {clan}."
msgstr "{clan} قبول شد."

#: clashogram/commands.py:678
#, python-brace-format
msgid "Denied {clan}."
msgstr "{clan} رد شد."

#: clashogram/commands.py:688
#, python-brace-format
msgid "{who} (owner)"
msgstr "{who} (مالک)"

#: clashogram/commands.py:695
msgid "Usage: /addoperator USER_ID"
msgstr "طرز استفاده: /addoperator USER_ID"

#: clashogram/commands.py:697
msgid "That is the owner!"
msgstr "خودش که مالکه!"

#: clashogram/commands.py:699
#, python-brace-format
msgid "{who} can now operate."
msgstr "{who} حالا اپراتوره."

#: clashogram/commands.py:701
msgid "You are an operator now! Send /help."
msgstr "حالا اپراتوری! /help رو بزن."

#: clashogram/commands.py:706
msgid "Usage: /removeoperator USER_ID"
msgstr "طرز استفاده: /removeoperator USER_ID"

#: clashogram/commands.py:708
msgid "The owner stays boss!"
msgstr "رئیس، مالک سر جاش می‌مونه!"

#: clashogram/commands.py:710
#, python-brace-format
msgid "{who} was not an operator."
msgstr "{who} اپراتور نبود."

#: clashogram/commands.py:712
#, python-brace-format
msgid "{who} can no longer operate."
msgstr "{who} دیگه اپراتور نیست."

#: clashogram/commands.py:737
msgid "Not taking requests."
msgstr "درخواست قبول نمی‌کنم."

#: clashogram/commands.py:739
msgid "Usage: /request CLAN_TAG"
msgstr "طرز استفاده: /request CLAN_TAG"

#: clashogram/commands.py:751
msgid "Already waiting."
msgstr "قبلاً درخواستش رو دادی."

#: clashogram/commands.py:752
msgid "Asked! You will hear back."
msgstr "درخواست ثبت شد! خبرت می‌کنم."

#: clashogram/formatters.py:16
msgid " League standings"
msgstr " جدول لیگ"

#: clashogram/formatters.py:17
msgid "Rank, stars, destruction, rounds, clan"
msgstr "رتبه، ستاره، تخریب، دور، قبیله"

#: clashogram/formatters.py:26
msgid " League season"
msgstr " فصل لیگ"

#: clashogram/formatters.py:27
msgid "Stars, used, missed, name"
msgstr "ستاره، زده، نزده، نام"

#: clashogram/formatters.py:37
msgid "Everyone has attacked."
msgstr "همه حمله‌شون رو زدن."

#: clashogram/formatters.py:38
msgid " Attacks left"
msgstr " حمله‌های نزده"

#: clashogram/formatters.py:51
#, python-brace-format
msgid ""
"{top_imoji} {war_size} fold war is ahead!\n"
"<pre>▫️ Clan {ourclan: <{cwidth}} L {ourlevel: <2} +{clanwinstreak} "
"{clanloc}{clanflag}\n"
"▪️ Clan {opponentclan: <{cwidth}} L {theirlevel: <2} +{opwinstreak} "
"{oploc}{opflag}</pre>\n"
"Game begins at {start}.\n"
"Have fun! {final_emoji}\n"
msgstr ""
"{top_imoji} وار {war_size} ‌تائی در راه است!\n"
"<pre>▫️ کلن {ourclan: <{cwidth}} ل {ourlevel: <2} +{clanwinstreak} "
"{clanloc}{clanflag}\n"
"▪️ کلن {opponentclan: <{cwidth}} ل {theirlevel: <2} +{opwinstreak} "
"{oploc}{opflag}</pre>\n"
"بازی {start} شروع می‌شود.\n"
"شاد باشید! {final_emoji}\n"

#: clashogram/formatters.py:84
msgid "⚔️ This one is hard mode."
msgstr "⚔️ این دور هارد موده."

#: clashogram/formatters.py:88
msgid " Players"
msgstr " لیست همبازی‌ها"

#: clashogram/formatters.py:89
msgid "Position, TH, name"
msgstr "ردیف، ت.ه، نام"

#: clashogram/formatters.py:103
msgid "War has begun!"
msgstr "جنگ قبیله شروع شد!"

#: clashogram/formatters.py:106
msgid "⚪️ We destroyed them 100% boss!"
msgstr "⚫️ رئیس فول زدیمشون!"

#: clashogram/formatters.py:117
#, python-brace-format
msgid ""
"<pre>{top_imoji} [{order}] {ourclan} vs {opponentclan}\n"
"Attacker: TH {attacker_thlevel: <2} MP {attacker_map_position} "
"{attacker_name}\n"
"Defender: TH {defender_thlevel: <2} MP {defender_map_position} "
"{defender_name}\n"
"Result: {stars} | {destruction_percentage}%\n"
"{war_info}\n"
"</pre>"
msgstr ""
"<pre>{top_imoji} {order} ک {ourclan} و {opponentclan}\n"
"مهاجم:  ت {attacker_thlevel: <2} ر {attacker_map_position} "
"{attacker_name}\n"
"مدافع:  ت {defender_thlevel: <2} ر {defender_map_position} "
"{defender_name}\n"
"نتیجه: {stars} | {destruction_percentage}%\n"
"{war_info}\n"
"</pre>"

#: clashogram/formatters.py:148
#, python-brace-format
msgid ""
"▪ {clan_attack_count: >{atkwidth}}/{total} ⭐ {clan_stars: <{swidth}} ⚡ "
"{clan_destruction:.2f}%\n"
"▪ {opponent_attack_count: >{atkwidth}}/{total} ⭐ {opponent_stars: "
"<{swidth}} ⚡ {opponent_destruction:.2f}%"
msgstr ""

#: clashogram/formatters.py:169
msgid "⚫️ They destroyed us 100% boss!"
msgstr "⚫️ رئیس فول خوردیم!"

#: clashogram/formatters.py:172
#, python-brace-format
msgid ""
