#: clashogram/commands.py:80 clashogram/commands.py:389
msgid "I follow Clash of Clans wars and post them here."
msgstr "Я слежу за войнами Clash of Clans и пишу о них сюда."

#: clashogram/commands.py:84
msgid ""
"No names on channel posts, so I cannot tell who you are here. Send me "
"this directly instead:"
msgstr ""
"У постов в канале нет автора, так что я не знаю, кто ты. Пришли мне это "
"напрямую:"

#: clashogram/commands.py:85 clashogram/commands.py:223
#, python-brace-format
msgid "/add CLAN_TAG {chat}"
msgstr "/add CLAN_TAG {chat}"

#: clashogram/commands.py:87
msgid "Whoever runs this chat can start me off:"
msgstr "Тот, кто ведёт этот чат, может меня запустить:"

#: clashogram/commands.py:88
msgid "/follow CLAN_TAG"
msgstr "/follow CLAN_TAG"

#: clashogram/commands.py:89
msgid "/help for the rest."
msgstr "Остальное — /help."

#: clashogram/commands.py:142
msgid "Unknown command. Try /help."
msgstr "Не знаю такой команды. Нажми /help."

#: clashogram/commands.py:145 clashogram/commands.py:405
msgid "No clan followed here yet."
msgstr "Тут пока ни одного клана."

#: clashogram/commands.py:172
msgid "I post attacks, prep, standings and result."
msgstr "Я пишу про атаки, подготовку, таблицу и результат."

#: clashogram/commands.py:175 clashogram/commands.py:207
msgid "Only somebody who runs this chat can change that."
msgstr "Это может менять только тот, кто ведёт этот чат."

#: clashogram/commands.py:179
msgid "Tap to turn a kind on or off."
msgstr "Нажми чтобы включить или выключить."

#: clashogram/commands.py:201
msgid "Which language?"
msgstr "Какой язык?"

#: clashogram/commands.py:205
msgid "I do not speak that."
msgstr "На этом я не говорю."

#: clashogram/commands.py:211
#, python-brace-format
msgid "Talking {lang} here now."
msgstr "Теперь тут говорю на {lang}."

#: clashogram/commands.py:218
#, python-brace-format
msgid "This chat is {chat}."
msgstr "Этот чат — {chat}."

#: clashogram/commands.py:220
msgid "That is your own user id too."
msgstr "Это заодно и твой ID."

#: clashogram/commands.py:222
msgid "To follow a clan here:"
msgstr "Чтобы добавить клан сюда:"

#: clashogram/commands.py:225
msgid "To ask for a clan here:"
msgstr "Чтобы попросить клан сюда:"

#: clashogram/commands.py:226
msgid "/request CLAN_TAG"
msgstr "/request CLAN_TAG"

#: clashogram/commands.py:243
msgid "How the war stands"
msgstr "Как идут дела на войне"

#: clashogram/commands.py:244
msgid "How long the war has to run"
msgstr "Сколько ещё идёт война"

#: clashogram/commands.py:245
msgid "Who still has attacks"
msgstr "Кто ещё не атаковал"

#: clashogram/commands.py:246
msgid "Who is facing whom"
msgstr "Кто против кого"

#: clashogram/commands.py:247
msgid "The league table"
msgstr "Таблица лиги"

#: clashogram/commands.py:248
msgid "League attack stats"
msgstr "Статистика атак в лиге"

#: clashogram/commands.py:249
msgid "The clan itself"
msgstr "Сам клан"

#: clashogram/commands.py:250
msgid "Who runs the clan"
msgstr "Кто руководит кланом"

#: clashogram/commands.py:251
msgid "Who has given the most"
msgstr "Кто больше всех отдал"

#: clashogram/commands.py:252
msgid "Pick the language here"
msgstr "Выбрать язык здесь"

#: clashogram/commands.py:253
msgid "This chat's id"
msgstr "ID этого чата"

#: clashogram/commands.py:254
msgid "What I can do"
msgstr "Что я умею"

#: clashogram/commands.py:258
msgid "What is followed where"
msgstr "За чем и где слежу"

#: clashogram/commands.py:259
msgid "Who is using me"
msgstr "Кто мной пользуется"

#: clashogram/commands.py:260
msgid "Follow a clan here"
msgstr "Следить за кланом здесь"

#: clashogram/commands.py:261
msgid "Stop following a clan here"
msgstr "Перестать следить за кланом здесь"

#: clashogram/commands.py:262
msgid "Follow a clan in another chat"
msgstr "Следить за кланом в другом чате"

#: clashogram/commands.py:263
msgid "Stop following a clan"
msgstr "Убрать клан"

#: clashogram/commands.py:264
msgid "Who has asked"
msgstr "Кто просил"

#: clashogram/commands.py:265
msgid "Choose what I post"
msgstr "Выбрать что я пишу"

#: clashogram/commands.py:266
msgid "Who may operate"
msgstr "Кто в операторах"

#: clashogram/commands.py:267
msgid "Let somebody help"
msgstr "Сделать оператором"

#: clashogram/commands.py:268
msgid "Stop letting them"
msgstr "Убрать из операторов"

#: clashogram/commands.py:285
#, python-brace-format
msgid ""
"No names on channel posts, so I cannot tell it is you boss! Send it to me"
" directly and add this chat: {chat}"
msgstr ""
"Посты в канале без имени, не вижу что это ты, босс! Напиши мне напрямую и"
" укажи этот чат: {chat}"

#: clashogram/commands.py:287
msgid "Owner only boss! Ask them."
msgstr "Только владелец, босс! Попроси его."

#: clashogram/commands.py:289
msgid "Operators only! Ask for your clan instead: /request CLAN_TAG"
msgstr "Только операторы! Лучше попроси свой клан: /request CLAN_TAG"

#: clashogram/commands.py:290
msgid "Operators only! Ask one to add your clan here."
msgstr "Только операторы! Попроси кого-нибудь добавить твой клан сюда."

#: clashogram/commands.py:329
msgid "somebody"
msgstr "кто-то"

#: clashogram/commands.py:338
#, python-brace-format
msgid "this chat ({chat})"
msgstr "этот чат ({chat})"

#: clashogram/commands.py:392
#, python-brace-format
msgid "Following {clans} here."
msgstr "Тут слежу за {clans}."

#: clashogram/commands.py:394
msgid "About the war:"
msgstr "Про войну:"

#: clashogram/commands.py:395
msgid "  /war        how it stands"
msgstr "  /war        как идут дела"

#: clashogram/commands.py:396
msgid "  /missing    who still has attacks"
msgstr "  /missing    кто ещё не атаковал"

#: clashogram/commands.py:397
msgid "  /standings  the league table"
msgstr "  /standings  таблица лиги"

#: clashogram/commands.py:398
msgid "  /stats      league attack stats"
msgstr "  /stats      статистика атак в лиге"

#: clashogram/commands.py:399
msgid "  /clan       the clan itself"
msgstr "  /clan       сам клан"

#: clashogram/commands.py:400
msgid "  /leaders    who runs it"
msgstr "  /leaders    кто им руководит"

#: clashogram/commands.py:401
msgid "  /left       how long the war has to run"
msgstr "  /left       сколько ещё идёт война"

#: clashogram/commands.py:402
msgid "  /mirror     who is facing whom"
msgstr "  /mirror     кто против кого"

#: clashogram/commands.py:403
msgid "  /donors     who has given the most"
msgstr "  /donors     кто больше всех отдал"

#: clashogram/commands.py:410
msgid "To ask for one:"
msgstr "Чтобы попросить:"

#: clashogram/commands.py:411
msgid "  /request CLAN_TAG    ask for a clan here"
msgstr "  /request CLAN_TAG    попросить клан сюда"

#: clashogram/commands.py:413
msgid "Requests are closed. Ask an operator!"
msgstr "Заявки закрыты. Попроси оператора!"

#: clashogram/commands.py:416
#, python-brace-format
msgid ""
"No names on channel posts, so I cannot tell who you are here. Anything "
"that changes things, send to me directly and add this chat ({chat})."
msgstr ""
"Посты в канале без имени, так что я не вижу кто ты. Всё что меняет "
"настройки — пиши мне напрямую и указывай этот чат ({chat})."

#: clashogram/commands.py:417
msgid "You can add me to a group or a channel too."
msgstr "Меня можно добавить в группу или канал."

#: clashogram/commands.py:418
msgid "Anywhere:"
msgstr "Везде:"

#: clashogram/commands.py:419
msgid "  /chatid     this chat's id, and yours if we talk directly"
msgstr "  /chatid     ID этого чата, и твой если пишешь мне лично"

#: clashogram/commands.py:420
msgid "  /lang       pick the language here"
msgstr "  /lang       выбрать язык здесь"

#: clashogram/commands.py:421
msgid "  /mute       choose what I post here"
msgstr "  /mute       выбрать что я пишу здесь"

#: clashogram/commands.py:422
msgid "  /help       this message"
msgstr "  /help       это сообщение"

#: clashogram/commands.py:425
msgid "Owner:"
msgstr "Владелец:"

#: clashogram/commands.py:426
msgid "  /operators              who may operate"
msgstr "  /operators              кто в операторах"

#: clashogram/commands.py:427
msgid "  /addoperator USER_ID    let somebody help"
msgstr "  /addoperator USER_ID    сделать оператором"

#: clashogram/commands.py:428
msgid "  /removeoperator USER_ID stop letting them"
msgstr "  /removeoperator USER_ID убрать из операторов"

#: clashogram/commands.py:429
msgid "  /requests open|close    take requests, or stop"
msgstr "  /requests open|close    открыть или закрыть заявки"

#: clashogram/commands.py:430
msgid "They send me /chatid directly to find their user id."
msgstr "Свой ID они узнают, написав мне /chatid лично."

#: clashogram/commands.py:432
msgid "Operator:"
msgstr "Оператор:"

#: clashogram/commands.py:433
msgid "  /clans                     what is followed where"
msgstr "  /clans                     за чем и где слежу"

#: clashogram/commands.py:434
msgid "  /activity                  who is using me"
msgstr "  /activity                  кто мной пользуется"

#: clashogram/commands.py:435
msgid "  /follow CLAN_TAG           follow a clan here"
msgstr "  /follow CLAN_TAG           следить за кланом здесь"

#: clashogram/commands.py:436
msgid "  /unfollow CLAN_TAG         stop following here"
msgstr "  /unfollow CLAN_TAG         перестать следить здесь"

#: clashogram/commands.py:437
msgid "  /add CLAN_TAG [CHAT]       follow one in CHAT"
msgstr "  /add CLAN_TAG [CHAT]       следить за кланом в CHAT"

#: clashogram/commands.py:438
msgid "  /remove CLAN_TAG [CHAT]    stop following"
msgstr "  /remove CLAN_TAG [CHAT]    убрать клан"

#: clashogram/commands.py:442
msgid "  /requests                  who has asked"
msgstr "  /requests                  кто просил"

#: clashogram/commands.py:443
msgid "  /approve ID, /deny ID      settle a request"
msgstr "  /approve ID, /deny ID      принять или отклонить"

#: clashogram/commands.py:446
msgid "Requests are closed, so clans are yours to add."
msgstr "Заявки закрыты, так что кланы добавляешь только ты."

#: clashogram/commands.py:448
msgid ""
"I cannot tell who posts in a channel. Add me there, then send /add here "
"with the id I report."
msgstr ""
"В канале я не вижу кто пишет. Добавь меня туда, потом пришли сюда /add с "
"тем ID, который я назову."

#: clashogram/commands.py:458 clashogram/commands.py:464
#: clashogram/commands.py:483 clashogram/commands.py:502
msgid "Not in a war."
msgstr "Сейчас войны нет."

#: clashogram/commands.py:470 clashogram/commands.py:476
msgid "Not in a league war."
msgstr "Сейчас нет войны лиги."

#: clashogram/commands.py:485
msgid "until battle day"
msgstr "до дня битвы"

#: clashogram/commands.py:487
msgid "until the war ends"
msgstr "до конца войны"

#: clashogram/commands.py:489
msgid "The war is over."
msgstr "Война уже кончилась."

#: clashogram/commands.py:494
msgid "Any moment now."
msgstr "Вот-вот."

#: clashogram/commands.py:496
#, python-brace-format
msgid "{hours}h {minutes}m {what}"
msgstr "{hours} ч {minutes} мин {what}"

#: clashogram/commands.py:505
msgid "Everyone against their mirror:"
msgstr "Каждый против своего зеркала:"

#: clashogram/commands.py:511
msgid "Nobody has given anything."
msgstr "Никто ничего не отдал."

#: clashogram/commands.py:514
msgid "Given, received, name:"
msgstr "Отдал, получил, имя:"

#: clashogram/commands.py:519
#, python-brace-format
msgid "War win streak {streak} {flag}"
msgstr "Серия побед {streak} {flag}"

#: clashogram/commands.py:522 clashogram/commands.py:532
#, python-brace-format
msgid "Leader {name}"
msgstr "Глава {name}"

#: clashogram/commands.py:530
msgid "Nobody is listed."
msgstr "Никого нет в списке."

#: clashogram/commands.py:532
#, python-brace-format
msgid "Co-leader {name}"
msgstr "Соруководитель {name}"

#: clashogram/commands.py:556
msgid "No clans followed."
msgstr "Ни за одним кланом не слежу."

#: clashogram/commands.py:572
#, python-brace-format
msgid "{clan} in {chat}"
msgstr "{clan} в {chat}"

#: clashogram/commands.py:574
msgid "Stop following"
msgstr "Убрать"

#: clashogram/commands.py:585
msgid "Nobody has said anything yet."
msgstr "Пока никто ничего не сказал."

#: clashogram/commands.py:602
#, python-brace-format
msgid "{chats} chats, {clans} clans, {operators} operators, {waiting} waiting."
msgstr ""
"Чатов: {chats}, кланов: {clans}, операторов: {operators}, в очереди: "
"{waiting}."

#: clashogram/commands.py:607
msgid "Last seen, language, clans. Quietest first:"
msgstr "Последний раз, язык, кланы. Самые тихие сверху:"

#: clashogram/commands.py:615
msgid "never"
msgstr "никогда"

#: clashogram/commands.py:620
#, python-brace-format
msgid "{count}d"
msgstr "{count}д"

#: clashogram/commands.py:622
#, python-brace-format
msgid "{count}h"
msgstr "{count}ч"

#: clashogram/commands.py:623
#, python-brace-format
msgid "{count}m"
msgstr "{count}м"

#: clashogram/commands.py:628
msgid "Usage: /add CLAN_TAG [CHAT_ID]"
msgstr "Как надо: /add CLAN_TAG [CHAT_ID]"

#: clashogram/commands.py:633 clashogram/commands.py:798
#, python-brace-format
msgid "No clan with tag {clan}!"
msgstr "Нет клана с тегом {clan}!"

#: clashogram/commands.py:639
#, python-brace-format
msgid "Following {name} ({clan}) in {chat}."
msgstr "Слежу за {name} ({clan}) в {chat}."

#: clashogram/commands.py:672
msgid "Usage: /remove CLAN_TAG [CHAT_ID]"
msgstr "Как надо: /remove CLAN_TAG [CHAT_ID]"

#: clashogram/commands.py:677
#, python-brace-format
msgid "{clan} was not followed in {chat}."
msgstr "За {clan} в {chat} я и не следил."

#: clashogram/commands.py:679
#, python-brace-format
msgid "Stopped following {clan} in {chat}."
msgstr "Больше не слежу за {clan} в {chat}."

#: clashogram/commands.py:687
msgid "Requests are open."
msgstr "Заявки открыты."

#: clashogram/commands.py:688
msgid "Requests are closed."
msgstr "Заявки закрыты."

#: clashogram/commands.py:690
msgid "Usage: /requests [open|close]"
msgstr "Как надо: /requests [open|close]"

#: clashogram/commands.py:693
msgid "Nothing waiting."
msgstr "Ничего не ждёт."

#: clashogram/commands.py:696 clashogram/commands.py:809
#, python-brace-format
msgid "{who} wants {name} ({clan}) in {chat}."
msgstr "{who} хочет {name} ({clan}) в {chat}."

#: clashogram/commands.py:705
msgid "Approve"
msgstr "Принять"

#: clashogram/commands.py:706
msgid "Deny"
msgstr "Отклонить"

#: clashogram/commands.py:719
msgid "Usage: /approve REQUEST_ID"
msgstr "Как надо: /approve REQUEST_ID"

#: clashogram/commands.py:722
msgid "No request with that number."
msgstr "Заявки с таким номером нет."

#: clashogram/commands.py:727
#, python-brace-format
msgid "{clan} is in! Its wars land here from now on."
msgstr "{clan} на месте! Теперь его войны приходят сюда."

#: clashogram/commands.py:729
#, python-brace-format
msgid "{clan} was turned down."
msgstr "{clan} отклонён."

#: clashogram/commands.py:731
#, python-brace-format
msgid "Approved {clan}."
msgstr "{clan} принят."

#: clashogram/commands.py:732
#, python-brace-format
msgid "Denied {clan}."
msgstr "{clan} отклонён."

#: clashogram/commands.py:742
#, python-brace-format
msgid "{who} (owner)"
msgstr "{who} (владелец)"

#: clashogram/commands.py:749
msgid "Usage: /addoperator USER_ID"
msgstr "Как надо: /addoperator USER_ID"

#: clashogram/commands.py:751
msgid "That is the owner!"
msgstr "Так это же владелец!"

#: clashogram/commands.py:753
#, python-brace-format
msgid "{who} can now operate."
msgstr "{who} теперь оператор."

#: clashogram/commands.py:755
msgid "You are an operator now! Send /help."
msgstr "Ты теперь оператор! Нажми /help."

#: clashogram/commands.py:760
msgid "Usage: /removeoperator USER_ID"
msgstr "Как надо: /removeoperator USER_ID"

#: clashogram/commands.py:762
msgid "The owner stays boss!"
msgstr "Владелец остаётся, босс!"

#: clashogram/commands.py:764
#, python-brace-format
msgid "{who} was not an operator."
msgstr "{who} и не был оператором."

#: clashogram/commands.py:766
#, python-brace-format
msgid "{who} can no longer operate."
msgstr "{who} больше не оператор."

#: clashogram/commands.py:792
msgid "Not taking requests."
msgstr "Заявки не принимаю."

#: clashogram/commands.py:794
msgid "Usage: /request CLAN_TAG"
msgstr "Как надо: /request CLAN_TAG"

#: clashogram/commands.py:806
msgid "Already waiting."
msgstr "Уже в очереди."

#: clashogram/commands.py:807
msgid "Asked! You will hear back."
msgstr "Заявка отправлена! Я сообщу."

#: clashogram/formatters.py:16
msgid " League standings"
msgstr " Таблица лиги"

#: clashogram/formatters.py:17
msgid "Rank, stars, destruction, rounds, clan"
msgstr "Место, звёзды, разрушение, туры, клан"

#: clashogram/formatters.py:26
msgid " League season"
msgstr " Сезон лиги"

#: clashogram/formatters.py:27
msgid "Stars, used, missed, name"
msgstr "Звёзды, атак, пропущено, имя"

#: clashogram/formatters.py:37
msgid "Everyone has attacked."
msgstr "Все атаковали."

#: clashogram/formatters.py:38
msgid " Attacks left"
msgstr " Осталось атак"

#: clashogram/formatters.py:51
#, python-brace-format
msgid ""
"{top_imoji} {war_size} fold war is ahead!\n"
"<pre>▫️ Clan {ourclan: <{cwidth}} L {ourlevel: <2} +{clanwinstreak} "
"{clanloc}{clanflag}\n"
"▪️ Clan {opponentclan: <{cwidth}} L {theirlevel: <2} +{opwinstreak} "
"{oploc}{opflag}</pre>\n"
"Game begins at {start}.\n"
"Have fun! {final_emoji}\n"
msgstr ""
"{top_imoji} {war_size} Объявлена война!\n"
"<pre>▫️ Клан {ourclan: <{cwidth}} Уровень: {ourlevel: <2} Серия: "
"+{clanwinstreak} {clanloc}{clanflag}\n"
"▪️ Клан {opponentclan: <{cwidth}} Уровень: {theirlevel: <2} Серия: "
"+{opwinstreak} {oploc}{opflag}</pre>\n"
"Начало битвы в {start}.\n"
"Удачных сражений! {final_emoji}"

#: clashogram/formatters.py:84
msgid "⚔️ This one is hard mode."
msgstr "⚔️ Этот тур в тяжёлом режиме."

#: clashogram/formatters.py:88
msgid " Players"
msgstr " Участники"

#: clashogram/formatters.py:89
msgid "Position, TH, name"
msgstr "Позиция, ТХ, имя"

#: clashogram/formatters.py:103
msgid "War has begun!"
msgstr "Война началась!"

#: clashogram/formatters.py:106
msgid "⚪️ We destroyed them 100% boss!"
msgstr "⚪️ Мы уничтожили их на 100%, босс!"

#: clashogram/formatters.py:117
#, python-brace-format
msgid ""
"<pre>{top_imoji} [{order}] {ourclan} vs {opponentclan}\n"
"Attacker: TH {attacker_thlevel: <2} MP {attacker_map_position} "
"{attacker_name}\n"
"Defender: TH {defender_thlevel: <2} MP {defender_map_position} "
"{defender_name}\n"
"Result: {stars} | {destruction_percentage}%\n"
"{war_info}\n"
"</pre>"
msgstr ""
"<pre>{top_imoji} [{order}] {ourclan} vs {opponentclan}\n"
"Атакующий: ТХ: {attacker_thlevel: <2} ПОЗИЦИЯ: {attacker_map_position} "
"{attacker_name}\n"
"Защитник:  ТХ: {defender_thlevel: <2} ПОЗИЦИЯ: {defender_map_position} "
"{defender_name}\n"
"Результат: {stars} | {destruction_percentage}%\n"
"{war_info}\n"
"</pre>"

#: clashogram/formatters.py:148
#, python-brace-format
msgid ""
"▪ {clan_attack_count: >{atkwidth}}/{total} ⭐ {clan_stars: <{swidth}} ⚡ "
"{clan_destruction:.2f}%\n"
"▪ {opponent_attack_count: >{atkwidth}}/{total} ⭐ {opponent_stars: "
"<{swidth}} ⚡ {opponent_destruction:.2f}%"
msgstr ""
"▪ {clan_attack_count: >{atkwidth}}/{total} ⭐ {clan_stars: <{swidth}} ⚡ "
"{clan_destruction:.2f}%\n"
"▪ {opponent_attack_count: >{atkwidth}}/{total} ⭐ {opponent_stars: "
"<{swidth}} ⚡ {opponent_destruction:.2f}%"

#: clashogram/formatters.py:169
msgid "⚫️ They destroyed us 100% boss!"
msgstr "⚫️ Они уничтожили нас на 100%, босс!"

#: clashogram/formatters.py:172
#, python-brace-format
msgid ""
"<pre>{win_or_lose_title}\n"
"Clan {ourclan: <{cwidth}} L {ourlevel: <2}\n"
"Clan {opponentclan: <{cwidth}} L {theirlevel: <2}\n"
"{war_info}\n"
"</pre>"
msgstr ""
