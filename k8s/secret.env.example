# Copy to secret.env and fill in. secret.env is gitignored.
# One-time, or whenever values change:
#   kubectl -n clashogram create secret generic clashogram \
#       --from-env-file=k8s/secret.env --dry-run=client -o yaml | kubectl apply -f -
# COC_API_TOKEN must be issued for the k3s node's external IP.
COC_API_TOKEN=
COC_CLAN_TAG=#YVL0C8UY
TELEGRAM_BOT_TOKEN=
# Test channel: @name for a public channel, numeric id for a private
# one (find it with scripts/telegram.sh updates).
TELEGRAM_CHAT_ID=
LANGUAGE=fa_IR
# Numeric Telegram user id of the owner, who may run the operator
# commands and name others. Send /chatid to the bot in a direct chat.
TELEGRAM_ADMIN_ID=
# ARCHIVE and OPEN_REQUESTS are flags: 1/0, true/false, yes/no, on/off, or
# empty, which means off. Case does not matter. Anything else refuses to
# start rather than being guessed at.
# Keep finished wars so clashogram-export-wars has something to write.
ARCHIVE=
# Let anyone ask for a clan with /request. The owner still decides.
OPEN_REQUESTS=
