# Copy to secret.yaml, fill in, and deploy is just:
#   kubectl apply -f k8s/
# secret.yaml is gitignored. Same values as secret.env; keep only one.
apiVersion: v1
kind: Secret
metadata:
  name: clashogram
  namespace: clashogram
type: Opaque
stringData:
  COC_API_TOKEN: ''
  COC_CLAN_TAG: '#YVL0C8UY'
  TELEGRAM_BOT_TOKEN: ''
  TELEGRAM_CHAT_ID: ''
  LANGUAGE: fa_IR
  TELEGRAM_ADMIN_ID: ''
  # Flags: '1'/'0', 'true'/'false', 'yes'/'no', 'on'/'off', or '' for off.
  # Case does not matter, and anything else refuses to start.
  ARCHIVE: ''
  OPEN_REQUESTS: ''
